<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lyd_sale_record_group_privilege" model="res.groups.privilege">
        <field name="name">Sale Record</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="lyd_sale_record_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="lyd_sale_record_group_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can import Excel files and view sale records.</field>
    </record>

    <record id="lyd_sale_record_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="lyd_sale_record_group_privilege"/>
        <field name="implied_ids" eval="[(4, ref('lyd_sale_record_group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can update and delete sale records.</field>
    </record>
</odoo>
